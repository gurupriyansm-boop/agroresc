    .preview-box { margin-top: 8px; max-width: 340px; }
    .preview-img { width: 100%; max-height: 260px; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); }
    .inspection-card { margin-top: 16px; background: white; border: 1px solid var(--line); border-left: 5px solid var(--green-primary); border-radius: 8px; padding: 16px; }
    .checklist { list-style: none; margin: 10px 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .checklist li { font-size: 0.85rem; background: var(--green-pale); padding: 6px 10px; border-radius: 6px; }
    .safety-warning { background: var(--amber-bg); border: 1px solid var(--amber-border); color: var(--amber-dark); padding: 10px 14px; border-radius: 6px; font-size: 0.82rem; font-weight: 650; margin-top: 10px; }
    .voice-controls { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; }
    .income-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 10px; }
    .income-stat { background: white; padding: 12px 14px; border-radius: 8px; border: 1px solid #d4e5d9; }
    .income-stat-label { font-size: 0.78rem; color: var(--muted); text-transform: uppercase; font-weight: 750; }
    .income-stat-val { font-size: 1.4rem; font-weight: 850; color: var(--green-dark); margin-top: 4px; }
    .income-stat.highlight { background: #ebf7ee; border-color: #92d8a6; }
    .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
    .metric-card { background: var(--green-pale); border: 1px solid #d0e4d7; padding: 16px; border-radius: 10px; text-align: center; }
    .metric-unit { font-size: 1.6rem; font-weight: 850; color: var(--green-dark); display: block; }
    .metric-label { font-size: 0.82rem; color: var(--muted); margin-top: 4px; display: block; font-weight: 650; }
    .sdg-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
    .sdg-badge { background: white; border: 1px solid #b7d6c1; color: var(--green-dark); font-size: 0.78rem; font-weight: 750; padding: 5px 12px; border-radius: 999px; }
    footer { border-top: 1px solid var(--line); background: white; padding: 22px 0; color: var(--muted); font-size: 0.85rem; text-align: center; }
    @media (max-width: 768px) {
      .grid-fields, .metrics-grid, .income-grid, .checklist { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<header>
  <div class="wrap header-inner">
    <div>
      <p class="eyebrow" data-en="RURAL DEVELOPMENT • SOCIAL IMPACT • AI-ASSISTED" data-ta="ஊரக வளர்ச்சி • சமூக தாக்கம் • செயற்கை நுண்ணறிவு உதவி">RURAL DEVELOPMENT • SOCIAL IMPACT • AI-ASSISTED</p>
      <h1>🌱 AgroRescue</h1>
      <p class="subtitle" data-en="Agricultural Surplus Recovery and Income Generation Platform" data-ta="விவசாய உபரி மீட்பு மற்றும் வருமான உருவாக்க தளம்">Agricultural Surplus Recovery and Income Generation Platform</p>
      <p class="tagline" data-en="“Save the produce. Recover the value. Empower farmers.”" data-ta="“விளைபொருளை காப்போம். மதிப்பைப் பெறுவோம். விவசாயிகளை உயர்த்துவோம்.”">“Save the produce. Recover the value. Empower farmers.”</p>
    </div>
    <button id="langToggle" class="btn-lang">🌐 தமிழ் (Tamil)</button>
  </div>
</header>

<main class="wrap">
  <div class="notice-banner">
    <div style="font-size:1.3rem">⚠️</div>
    <div>
      <strong data-en="Hackathon Prototype Notice:" data-ta="ஹேக்கத்தான் மாதிரி அறிவிப்பு:">Hackathon Prototype Notice:</strong>
      <span data-en=" Buyer and driver records are fictional demo data. Visual photo assessment is an honest rule-based checklist, not a trained AI model or food-safety certification. Always verify offers, weights, physical produce quality, and payment terms offline." data-ta=" வாங்குபவர் மற்றும் ஓட்டுநர் விவரங்கள் மாதிரித் தரவுகள் மட்டுமே. புகைப்பட ஆய்வு ஆரம்ப நிலை சரிபார்ப்பு மட்டுமே; இது ஆய்வக சான்றிதழ் அல்ல. உண்மையான தரம், விலை, போக்குவரத்து மற்றும் பணம் செலுத்துதலை உறுதிசெய்து கொள்ளவும்."> Buyer and driver records are fictional demo data. Visual photo assessment is an honest rule-based checklist, not a trained AI model or food-safety certification. Always verify offers, weights, physical produce quality, and payment terms offline.</span>
    </div>
  </div>

  <nav class="nav-pills">
    <a href="#list" data-en="1. List Surplus" data-ta="1. உபரி பதிவு">1. List Surplus</a>
    <a href="#buyers" data-en="2. Buyer Matches" data-ta="2. வாங்குபவர் பரிந்துரை">2. Buyer Matches</a>
    <a href="#transport" data-en="3. Transport" data-ta="3. போக்குவரத்து">3. Transport</a>
    <a href="#image" data-en="4. Photo Inspection" data-ta="4. புகைப்பட ஆய்வு">4. Photo Inspection</a>
    <a href="#voice" data-en="5. Voice Listing" data-ta="5. குரல் பதிவு">5. Voice Listing</a>
    <a href="#income" data-en="6. Net Return" data-ta="6. நிகர வருமானம்">6. Net Return</a>
    <a href="#impact" data-en="7. Impact & SDGs" data-ta="7. தாக்கம் & SDGs">7. Impact & SDGs</a>
  </nav>

  <!-- Step 1: Surplus Form -->
  <section class="card" id="list">
    <span class="badge">Step 1 / படி 1</span>
    <h2 data-en="Register Surplus Perishable Produce" data-ta="அழுகக்கூடிய உபரி விளைபொருட்களை பதிவு செய்க">Register Surplus Perishable Produce</h2>
    <p class="panel-sub" data-en="Enter details of your surplus batch to discover feasible buyers and transport options within 100 km." data-ta="100 கி.மீ சுற்றளவில் உள்ள வாங்குபவர்களையும் போக்குவரத்து வாய்ப்புகளையும் கண்டறிய விவரங்களை உள்ளிடவும்.">Enter details of your surplus batch to discover feasible buyers and transport options within 100 km.</p>

    <div class="preset-box">
      <span class="preset-label" data-en="Quick Scenarios:" data-ta="மாதிரி காட்சிகள்:">Quick Scenarios:</span>
      <button type="button" class="btn-chip" id="presetAyudha" data-en="🌾 Ayudha Pooja Surplus (Coimbatore)" data-ta="🌾 ஆயுதபூஜை காய்கறி உபரி (கோவை)">🌾 Ayudha Pooja Surplus (Coimbatore)</button>
      <button type="button" class="btn-chip" id="presetMango" data-en="🥭 Salem Mango Surplus (Processing)" data-ta="🥭 சேலம் மாம்பழ உபரி (பதப்படுத்துதல்)">🥭 Salem Mango Surplus (Processing)</button>
      <button type="button" class="btn-chip" id="presetFlower" data-en="🌸 Seasonal Flower Surplus (Market)" data-ta="🌸 மலர் உபரி (கோவை சந்தை)">🌸 Seasonal Flower Surplus (Market)</button>
    </div>

    <form id="listingForm">
      <div class="grid-fields">
        <div class="form-group">
          <label for="crop" data-en="Crop / Produce" data-ta="பயிர் / விளைபொருள்">Crop / Produce</label>
          <select id="crop">
            <option value="Vegetables">Vegetables (Mixed)</option>
            <option value="Tomato">Tomato</option>
            <option value="Mango">Mango</option>
            <option value="Banana">Banana</option>
            <option value="Flowers">Flowers</option>
          </select>
        </div>
        <div class="form-group">
          <label for="qty" data-en="Surplus Quantity (kg)" data-ta="உபரி அளவு (கிலோ)">Surplus Quantity (kg)</label>
          <input id="qty" type="number" min="1" max="1000000" value="200" required>
        </div>
        <div class="form-group">
          <label for="condition" data-en="Observed Condition" data-ta="விளைபொருள் தரம்">Observed Condition</label>
          <select id="condition">
            <option value="Fresh / saleable">Fresh / saleable</option>
            <option value="Ripe / suitable for processing">Ripe / suitable for processing</option>
            <option value="Needs inspection">Needs inspection</option>
          </select>
        </div>
        <div class="form-group">
          <label for="location" data-en="Location / Market Name" data-ta="இடம் / சந்தை பெயர்">Location / Market Name</label>
          <input id="location" type="text" value="Coimbatore" required>
        </div>
        <div class="form-group">
          <label for="lat" data-en="Latitude" data-ta="அட்சரேகை (Latitude)">Latitude</label>
          <input id="lat" type="number" step="any" min="-90" max="90" value="11.0168" required>
        </div>
        <div class="form-group">
          <label for="lon" data-en="Longitude" data-ta="தீர்க்கரேகை (Longitude)">Longitude</label>
          <input id="lon" type="number" step="any" min="-180" max="180" value="76.9558" required>
        </div>
        <div class="form-group">
          <label for="asking" data-en="Asking Price (₹/kg)" data-ta="கேட்கும் விலை (₹/கிலோ)">Asking Price (₹/kg)</label>
          <input id="asking" type="number" min="0" value="12" required>
        </div>
        <div class="form-group">
          <label for="urgency" data-en="Urgency Window (Hours)" data-ta="அவசரம் / சேமிப்பு நேரம் (மணிநேரம்)">Urgency Window (Hours)</label>
          <input id="urgency" type="number" min="1" max="720" value="24" required>
        </div>
      </div>
      <button type="submit" class="btn btn-primary" data-en="🔍 Find Suitable Matches" data-ta="🔍 பொருத்தமான வாங்குபவர்களைக் காண்க">🔍 Find Suitable Matches</button>
    </form>
    <div id="listingStatus" class="status-msg hidden"></div>
  </section>

  <!-- Step 2: Buyer Matches -->
  <section class="card" id="buyers">
    <span class="badge">Step 2 / படி 2</span>
    <h2 data-en="Recommended Nearby Buyers" data-ta="பரிந்துரைக்கப்படும் அருகிலுள்ள வாங்குபவர்கள்">Recommended Nearby Buyers</h2>
    <p class="panel-sub" data-en="Filtered by crop, accepted grade condition, buyer capacity, and 100km radius. Ranked by estimated net return." data-ta="பயிர், தரம், கொள்ளளவு மற்றும் 100 கி.மீ சுற்றளவு அடிப்படையில் வடிகட்டப்பட்டு, அதிக நிகர வருமானத்தின்படி வரிசைப்படுத்தப்பட்டுள்ளது.">Filtered by crop, accepted grade condition, buyer capacity, and 100km radius. Ranked by estimated net return.</p>
    <div id="buyerResults"><div class="placeholder-box" data-en="Submit a listing above or click a scenario to view matching buyer profiles." data-ta="பொருத்தமான வாங்குபவர்களைக் காண மேலே உள்ள படிவத்தை சமர்ப்பிக்கவும்.">Submit a listing above or click a scenario to view matching buyer profiles.</div></div>
  </section>

  <!-- Step 3: Transport Matches -->
  <section class="card" id="transport">
    <span class="badge">Step 3 / படி 3</span>
    <h2 data-en="Recommended Local Transport Providers" data-ta="பரிந்துரைக்கப்படும் உள்ளூர் போக்குவரத்து ஓட்டுநர்கள்">Recommended Local Transport Providers</h2>
    <p class="panel-sub" data-en="Filtered by active availability, load capacity, and distance. Sorted by lowest estimated fare." data-ta="செயலில் உள்ள இருப்பு, சுமை கொள்ளளவு மற்றும் தூரம் அடிப்படையில் வரிசைப்படுத்தப்பட்டுள்ளது.">Filtered by active availability, load capacity, and distance. Sorted by lowest estimated fare.</p>
    <div id="driverResults"><div class="placeholder-box" data-en="Submit a listing above to view matching transport providers." data-ta="பொருத்தமான போக்குவரத்து ஓட்டுநர்களைக் காண படிவத்தை சமர்ப்பிக்கவும்.">Submit a listing above to view matching transport providers.</div></div>
  </section>

  <!-- Step 4: Photo Inspection -->
  <section class="card" id="image">
    <span class="badge">Step 4 / படி 4</span>
    <h2 data-en="Produce Photo & Visual Inspection" data-ta="விளைபொருள் புகைப்படம் மற்றும் காட்சி ஆய்வு">Produce Photo & Visual Inspection</h2>
    <p class="panel-sub" data-en="Upload a photo to communicate visible produce quality. Our endpoint returns a preliminary physical inspection checklist." data-ta="விளைபொருளின் நிலையை வாங்குபவருக்கு காட்ட புகைப்படம் எடுக்கவும் அல்லது பதிவேற்றவும்.">Upload a photo to communicate visible produce quality. Our endpoint returns a preliminary physical inspection checklist.</p>
    <div style="margin-top:12px">
      <input type="file" id="photo" accept="image/*">
      <div id="previewContainer" class="preview-box hidden"><img id="preview" class="preview-img" alt="Produce Preview"></div>
      <button type="button" id="assess" class="btn btn-secondary" style="margin-top:10px" data-en="🔬 Run Preliminary Visual Inspection" data-ta="🔬 ஆரம்ப நிலை காட்சி ஆய்வு செய்க">🔬 Run Preliminary Visual Inspection</button>
    </div>
    <div id="imageResultCard" class="inspection-card hidden"></div>
  </section>

  <!-- Step 5: Voice Listing -->
  <section class="card" id="voice">
    <span class="badge">Step 5 / படி 5</span>
    <h2 data-en="Bilingual Voice-to-Text Listing (Tamil / English)" data-ta="இருமொழி குரல்வழி பதிவு (தமிழ் / ஆங்கிலம்)">Bilingual Voice-to-Text Listing (Tamil / English)</h2>
    <p class="panel-sub" data-en="Speak in Tamil or Indian English to dictate surplus details. Click 'Extract to Form' to auto-populate fields." data-ta="விவசாயிகள் தங்கள் மொழியிலேயே பேசி விவரங்களை பதிவு செய்யலாம். பின்னர் 'படிவத்தில் நிரப்பு' பொத்தானை அழுத்தவும்.">Speak in Tamil or Indian English to dictate surplus details. Click 'Extract to Form' to auto-populate fields.</p>
    <div class="voice-controls" style="margin-top:12px">
      <label for="language" style="margin:0" data-en="Speech Language:" data-ta="பேச்சு மொழி:">Speech Language:</label>
      <select id="language" style="width:auto">
        <option value="ta-IN">தமிழ் - Tamil (ta-IN)</option>
        <option value="en-IN">English (India - en-IN)</option>
      </select>
      <button type="button" id="speak" class="btn btn-accent" data-en="🎙 Start Voice Input" data-ta="🎙 குரல் பதிவு தொடங்கு">🎙 Start Voice Input</button>
    </div>
    <textarea id="transcript" placeholder="Example: 'Tomato 250 kg in Coimbatore asking price 12' or 'தக்காளி 250 கிலோ கோயம்புத்தூர்'..." rows="3"></textarea>
    <div style="margin-top:8px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <button type="button" id="btnExtractVoice" class="btn btn-secondary" style="padding:6px 14px;font-size:0.82rem" data-en="📥 Extract & Populate Listing Form" data-ta="📥 படிவத்தில் தானாக நிரப்பு">📥 Extract & Populate Listing Form</button>
      <span id="voiceExtractStatus" style="font-size:0.85rem;font-weight:700"></span>
    </div>
  </section>

  <!-- Step 6: Net Return Calculator -->
  <section class="card" id="income">
    <span class="badge">Step 6 / படி 6</span>
    <h2 data-en="Transparent Net-Return Calculator" data-ta="வெளிப்படையான நிகர வருமானக் கணக்கீடு">Transparent Net-Return Calculator</h2>
    <p class="panel-sub" data-en="Estimate true take-home earnings by subtracting transport, handling, and platform coordination costs from gross sale revenue." data-ta="மொத்த விற்பனைத் தொகையிலிருந்து போக்குவரத்து, கையாளுதல் செலவுகளைக் கழித்து உண்மையான நிகர வருமானத்தை கணக்கிடுங்கள்.">Estimate true take-home earnings by subtracting transport, handling, and platform coordination costs from gross sale revenue.</p>
    <div class="grid-fields" style="margin-top:14px">
      <div class="form-group">
        <label for="iqty" data-en="Quantity (kg)" data-ta="அளவு (கிலோ)">Quantity (kg)</label>
        <input id="iqty" type="number" value="500" min="0">
      </div>
      <div class="form-group">
        <label for="offer" data-en="Buyer Offer (₹/kg)" data-ta="வாங்குபவர் விலை (₹/கிலோ)">Buyer Offer (₹/kg)</label>
        <input id="offer" type="number" value="14" min="0">
      </div>
      <div class="form-group">
        <label for="transportCost" data-en="Transport Cost (₹)" data-ta="போக்குவரத்து செலவு (₹)">Transport Cost (₹)</label>
        <input id="transportCost" type="number" value="800" min="0">
      </div>
      <div class="form-group">
        <label for="handling" data-en="Handling Cost (₹)" data-ta="கையாளுதல் செலவு (₹)">Handling Cost (₹)</label>
        <input id="handling" type="number" value="250" min="0">
      </div>
      <div class="form-group">
        <label for="fee" data-en="Platform Coordination Fee (₹)" data-ta="தள ஒருங்கிணைப்பு கட்டணம் (₹)">Platform Coordination Fee (₹)</label>
        <input id="fee" type="number" value="0" min="0">
      </div>
    </div>
    <button type="button" id="calc" class="btn btn-primary" data-en="🧮 Calculate Net Earnings" data-ta="🧮 நிகர வருமானத்தை கணக்கிடு">🧮 Calculate Net Earnings</button>
    <div id="incomeResult" class="hidden" style="margin-top:16px;background:var(--green-pale);padding:18px;border-radius:10px;border:1px solid #c9e0cf"></div>
  </section>

  <!-- Step 7: Impact & SDGs -->
  <section class="card" id="impact">
    <span class="badge">Social Impact / சமூக தாக்கம்</span>
    <h2 data-en="Pilot Metrics & UN Sustainable Development Goals" data-ta="திட்ட அளவீடுகள் & ஐக்கிய நாடுகள் இலக்குகள்">Pilot Metrics & UN Sustainable Development Goals</h2>
    <p class="panel-sub" data-en="Indicators to track in field pilots across rural markets and Women SHG aggregation clusters." data-ta="கிராமப்புற சந்தைகள் மற்றும் மகளிர் சுயஉதவி குழுக்களில் அளவிடப்பட வேண்டிய குறிகாட்டிகள்.">Indicators to track in field pilots across rural markets and Women SHG aggregation clusters.</p>
