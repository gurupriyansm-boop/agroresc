def haversine_km(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    """Great-circle distance in km between two lat/lon coordinates."""
    r = 6371.0
    dlat = math.radians(lat2 - lat1)
    dlon = math.radians(lon2 - lon1)
    a = math.sin(dlat / 2) ** 2 + math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) * math.sin(dlon / 2) ** 2
    return 2 * r * math.atan2(math.sqrt(a), math.sqrt(1 - a))

def net_return(quantity_kg: float, offer_per_kg: float, transport_cost: float = 0.0, handling_cost: float = 0.0, platform_fee: float = 0.0) -> Dict[str, float]:
    """Calculates gross revenue, costs, and net return per transaction."""
    vals = [quantity_kg, offer_per_kg, transport_cost, handling_cost, platform_fee]
    if any(v < 0 for v in vals):
        raise ValueError("Financial and quantity values must be non-negative")
    gross = float(quantity_kg) * float(offer_per_kg)
    costs = float(transport_cost) + float(handling_cost) + float(platform_fee)
    net = gross - costs
    per_kg = round(net / quantity_kg, 2) if quantity_kg > 0 else 0.0
    return {
        "gross_revenue": round(gross, 2),
        "total_costs": round(costs, 2),
        "net_return": round(net, 2),
        "net_return_per_kg": per_kg
    }

def find_buyer_matches(listing: Dict[str, Any], buyers: List[Dict[str, Any]] = None, max_distance_km: float = 100.0) -> List[Dict[str, Any]]:
    """Filters and ranks buyers by estimated net return within max_distance_km."""
    if buyers is None:
        buyers = SAMPLE_BUYERS
    matches = []
    listing_crop = str(listing.get("crop", "")).strip().lower()
    listing_cond = str(listing.get("condition", "")).strip().lower()
    quantity_kg = float(listing.get("quantity_kg", 0))

    for buyer in buyers:
        buyer_crops = [str(c).strip().lower() for c in buyer.get("crops", [])]
        if listing_crop not in buyer_crops:
            continue

        buyer_conditions = [str(c).strip().lower() for c in buyer.get("accepted_conditions", [])]
        if listing_cond not in buyer_conditions:
            continue

        capacity = float(buyer.get("capacity_kg", 0))
        if capacity < quantity_kg:
            continue

        try:
            b_lat = float(buyer["lat"])
            b_lon = float(buyer["lon"])
            l_lat = float(listing["lat"])
            l_lon = float(listing["lon"])
        except (KeyError, ValueError, TypeError):
            continue

        distance = haversine_km(l_lat, l_lon, b_lat, b_lon)
        if distance > max_distance_km:
            continue

        offer = float(buyer.get("offer_per_kg", 0))
        default_transport = max(150.0, round(distance * 18.0, 2))
        transport = float(buyer.get("estimated_transport_cost") or default_transport)
        handling = float(buyer.get("estimated_handling_cost", 0.0))
        economics = net_return(quantity_kg, offer, transport, handling)

        matches.append({
            "buyer_id": buyer.get("id", "Unknown"),
            "buyer_name": buyer.get("name", "Unnamed Buyer"),
            "distance_km": round(distance, 1),
            "offer_per_kg": round(offer, 2),
            "estimated_transport_cost": round(transport, 2),
            "estimated_net_return": economics["net_return"],
            "condition_fit": True,
            "capacity_kg": capacity,
            "note": "Illustrative match only; confirm stock, grade, price, pickup and payment."
        })

    return sorted(matches, key=lambda m: (-m["estimated_net_return"], m["distance_km"]))

def find_transport_matches(listing: Dict[str, Any], drivers: List[Dict[str, Any]] = None, max_distance_km: float = 100.0) -> List[Dict[str, Any]]:
    """Filters active drivers with sufficient capacity and ranks by lowest cost."""
    if drivers is None:
        drivers = SAMPLE_DRIVERS
    matches = []
    quantity_kg = float(listing.get("quantity_kg", 0))

    for driver in drivers:
        if driver.get("available") is not True:
            continue

        capacity = float(driver.get("capacity_kg", 0))
        if capacity < quantity_kg:
            continue

        try:
            d_lat = float(driver["lat"])
            d_lon = float(driver["lon"])
            l_lat = float(listing["lat"])
            l_lon = float(listing["lon"])
        except (KeyError, ValueError, TypeError):
            continue

        distance = haversine_km(l_lat, l_lon, d_lat, d_lon)
        if distance > max_distance_km:
            continue

        base_fee = float(driver.get("base_fee", 0))
        rate_per_km = float(driver.get("rate_per_km", 0))
        est_cost = base_fee + (distance * rate_per_km)

        matches.append({
            "driver_id": driver.get("id", "Unknown"),
            "driver_name": driver.get("name", "Unnamed Driver"),
            "vehicle": driver.get("vehicle", "Mini truck"),
            "capacity_kg": capacity,
            "distance_km": round(distance, 1),
            "estimated_cost": round(est_cost, 2),
            "phone": driver.get("phone", "Not provided"),
            "note": "Demo profile; verify identity, vehicle documents, availability and final fare."
        })

    return sorted(matches, key=lambda m: (m["estimated_cost"], m["distance_km"]))

def preliminary_image_assessment(filename: str, content_type: str, file_size: int) -> Dict[str, Any]:
    """Safe rule-based inspection checklist (honest prototype disclaimer)."""
    if not content_type or not content_type.startswith("image/"):
        raise ValueError("Upload must be an image (e.g. image/jpeg, image/png)")
    if file_size <= 0:
        raise ValueError("Image is empty (0 bytes)")

    safe_name = Path(filename).name if filename else "upload.jpg"
    return {
        "status": "demo_placeholder",
        "filename": safe_name,
        "file_size_bytes": file_size,
        "visible_quality_estimate": "Visual inspection checklist generated (Not assessed by a trained model)",
        "possible_visual_checks": [
            "Surface bruising or mechanical transit cuts",
            "Abnormal discolouration or uneven pigment",
            "Shrivelling / moisture loss",
            "Visible fungal growth or surface mould"
        ],
        "recommended_next_step": "Ask seller to confirm variety and harvest date; arrange physical inspection by buyer.",
        "warning": "A photo cannot certify food safety or detect internal rot, pesticide residues, or microbial contamination."
    }

