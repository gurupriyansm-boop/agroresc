def run_embedded_tests():
    """Runs a complete unit and integration test suite directly from this file."""
    import unittest

    class TestAgroRescueSingleFile(unittest.TestCase):
        def test_haversine_same_point(self):
            self.assertAlmostEqual(haversine_km(11.0, 76.0, 11.0, 76.0), 0.0, places=3)

        def test_haversine_distance(self):
            d = haversine_km(11.0168, 76.9558, 11.6643, 78.1460)
            self.assertTrue(140 < d < 160)

        def test_net_return_valid(self):
            r = net_return(100, 12, 100, 50, 0)
            self.assertEqual(r["gross_revenue"], 1200.0)
            self.assertEqual(r["total_costs"], 150.0)
            self.assertEqual(r["net_return"], 1050.0)
            self.assertEqual(r["net_return_per_kg"], 10.5)

        def test_net_return_negative_rejected(self):
            with self.assertRaises(ValueError):
                net_return(100, 12, -10, 0, 0)

        def test_net_return_zero_quantity(self):
            r = net_return(0, 12, 0, 0, 0)
            self.assertEqual(r["net_return_per_kg"], 0.0)

        def test_buyer_matching(self):
            listing = {"crop": "Mango", "quantity_kg": 100, "condition": "Ripe / suitable for processing", "lat": 11.6643, "lon": 78.1460}
            matches = find_buyer_matches(listing, SAMPLE_BUYERS)
            self.assertGreater(len(matches), 0)
            self.assertEqual(matches[0]["buyer_id"], "B003")

        def test_buyer_capacity_filter(self):
            listing = {"crop": "Mango", "quantity_kg": 6000, "condition": "Ripe / suitable for processing", "lat": 11.6643, "lon": 78.1460}
            matches = find_buyer_matches(listing, SAMPLE_BUYERS)
            self.assertEqual(len(matches), 0)

        def test_transport_availability(self):
            listing = {"quantity_kg": 200, "lat": 11.0168, "lon": 76.9558}
            matches = find_transport_matches(listing, SAMPLE_DRIVERS)
            for m in matches:
                self.assertNotEqual(m["driver_id"], "D004")

        def test_image_assessment_placeholder(self):
            r = preliminary_image_assessment("tomato.jpg", "image/jpeg", 500)
            self.assertEqual(r["status"], "demo_placeholder")
            self.assertIn("cannot certify food safety", r["warning"])

        def test_image_assessment_non_image_rejected(self):
            with self.assertRaises(ValueError):
                preliminary_image_assessment("notes.txt", "text/plain", 100)

    suite = unittest.TestLoader().loadTestsFromTestCase(TestAgroRescueSingleFile)
    runner = unittest.TextTestRunner(verbosity=2)
    result = runner.run(suite)
    sys.exit(0 if result.wasSuccessful() else 1)

