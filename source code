def create_fastapi_app():
    """Instantiates a production-ready FastAPI application with Pydantic validation."""
    from fastapi import FastAPI, HTTPException, UploadFile, File
    from fastapi.responses import HTMLResponse
    from fastapi.middleware.cors import CORSMiddleware
    from pydantic import BaseModel, Field, field_validator

    app = FastAPI(
        title="AgroRescue API",
        version="0.2.0",
        description="AgroRescue: AI-Powered Agricultural Surplus Recovery & Income Generation Platform (Phase A Hackathon Demo).",
        docs_url="/docs",
        redoc_url="/redoc"
    )

    app.add_middleware(
        CORSMiddleware,
        allow_origins=["*"],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )

    class ListingModel(BaseModel):
        id: str = None
        crop: str = Field(..., min_length=2, max_length=60)
        quantity_kg: float = Field(..., gt=0, le=1_000_000)
        condition: str = Field(..., min_length=2, max_length=100)
        location_name: str = Field(..., min_length=2, max_length=100)
        lat: float = Field(..., ge=-90.0, le=90.0)
        lon: float = Field(..., ge=-180.0, le=180.0)
        asking_price_per_kg: float = Field(..., ge=0, le=100_000)
        urgency_hours: int = Field(..., gt=0, le=720)

        @field_validator("crop", "condition", "location_name")
        @classmethod
        def strip_text(cls, v: str) -> str:
            s = v.strip()
            if not s:
                raise ValueError("Field cannot be blank")
            return s

    class ReturnModel(BaseModel):
        quantity_kg: float = Field(..., ge=0, le=1_000_000)
        offer_per_kg: float = Field(..., ge=0, le=100_000)
        transport_cost: float = Field(default=0.0, ge=0)
        handling_cost: float = Field(default=0.0, ge=0)
        platform_fee: float = Field(default=0.0, ge=0)

    @app.get("/", response_class=HTMLResponse)
    def serve_ui():
        return HTML_CONTENT

    @app.get("/api/health")
    def health():
        return {
            "status": "ok",
            "project": "AgroRescue",
            "title": "AgroRescue: AI-Powered Agricultural Surplus Recovery and Income Generation Platform",
            "version": "0.2.0",
            "mode": "demo_proof_of_concept",
            "theme": "Rural Development and Livelihood"
        }

    @app.get("/api/buyers")
    def get_buyers():
        return SAMPLE_BUYERS

    @app.get("/api/drivers")
    def get_drivers():
        return SAMPLE_DRIVERS

    @app.get("/api/listings")
    def get_listings():
        return SAMPLE_LISTINGS

    @app.post("/api/matches/buyers")
    def match_buyers(listing: ListingModel):
        matches = find_buyer_matches(listing.model_dump(), SAMPLE_BUYERS)
        return {"matches": matches, "count": len(matches), "disclaimer": "Sample matches from fictional demo data."}

    @app.post("/api/matches/transport")
    def match_transport(listing: ListingModel):
        matches = find_transport_matches(listing.model_dump(), SAMPLE_DRIVERS)
        return {"matches": matches, "count": len(matches), "disclaimer": "Sample drivers from fictional demo data."}

    @app.post("/api/net-return")
    def calc_return(req: ReturnModel):
        try:
            return net_return(req.quantity_kg, req.offer_per_kg, req.transport_cost, req.handling_cost, req.platform_fee)
        except ValueError as exc:
            raise HTTPException(status_code=400, detail=str(exc))

    @app.post("/api/image-assessment")
    async def assess_image(file: UploadFile = File(...)):
        if not file.content_type or not file.content_type.startswith("image/"):
            raise HTTPException(status_code=400, detail="Uploaded file must have an image MIME type (e.g. image/jpeg, image/png).")
        content = await file.read()
        if len(content) > 8 * 1024 * 1024:
            raise HTTPException(status_code=413, detail="Image must be 8 MB or smaller.")
        if len(content) == 0:
            raise HTTPException(status_code=400, detail="Uploaded image is empty (0 bytes).")
        try:
            return preliminary_image_assessment(file.filename or "upload.jpg", file.content_type, len(content))
        except ValueError as exc:
            raise HTTPException(status_code=400, detail=str(exc))

    return app

def run_stdlib_server(host="127.0.0.1", port=8000):
    """Fallback server using pure Python standard library (Zero third-party packages required)."""
    from http.server import HTTPServer, BaseHTTPRequestHandler
    from urllib.parse import urlparse

    class AgroHandler(BaseHTTPRequestHandler):
        def _send_json(self, status: int, data: Any):
            body = json.dumps(data).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(body)

        def _send_html(self, status: int, html_text: str):
            body = html_text.encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            parsed = urlparse(self.path)
            path = parsed.path
            if path in ["/", "/index.html"]:
                self._send_html(200, HTML_CONTENT)
            elif path == "/api/health":
                self._send_json(200, {
                    "status": "ok",
                    "project": "AgroRescue",
                    "engine": "stdlib_http_server",
                    "version": "0.2.0",
                    "mode": "demo_proof_of_concept"
                })
            elif path == "/api/buyers":
                self._send_json(200, SAMPLE_BUYERS)
            elif path == "/api/drivers":
                self._send_json(200, SAMPLE_DRIVERS)
            elif path == "/api/listings":
                self._send_json(200, SAMPLE_LISTINGS)
            else:
                self._send_json(404, {"detail": "Not Found"})

        def do_POST(self):
            parsed = urlparse(self.path)
            path = parsed.path
            content_len = int(self.headers.get("Content-Length", 0))
            raw_body = self.rfile.read(content_len)

            if path == "/api/matches/buyers":
                try:
                    payload = json.loads(raw_body.decode("utf-8"))
                    matches = find_buyer_matches(payload, SAMPLE_BUYERS)
                    self._send_json(200, {"matches": matches, "count": len(matches)})
                except Exception as err:
                    self._send_json(400, {"detail": str(err)})

            elif path == "/api/matches/transport":
                try:
                    payload = json.loads(raw_body.decode("utf-8"))
                    matches = find_transport_matches(payload, SAMPLE_DRIVERS)
                    self._send_json(200, {"matches": matches, "count": len(matches)})
                except Exception as err:
                    self._send_json(400, {"detail": str(err)})

            elif path == "/api/net-return":
                try:
                    p = json.loads(raw_body.decode("utf-8"))
                    res = net_return(p["quantity_kg"], p["offer_per_kg"], p.get("transport_cost", 0), p.get("handling_cost", 0), p.get("platform_fee", 0))
                    self._send_json(200, res)
                except Exception as err:
                    self._send_json(400, {"detail": str(err)})

            elif path == "/api/image-assessment":
                ctype = self.headers.get("Content-Type", "")
                if "image" not in ctype and "multipart" not in ctype:
                    self._send_json(400, {"detail": "Uploaded file must be an image"})
                    return
                res = preliminary_image_assessment("upload.jpg", "image/jpeg", max(len(raw_body), 1024))
                self._send_json(200, res)
            else:
                self._send_json(404, {"detail": "Not Found"})

    server = HTTPServer((host, port), AgroHandler)
    print("\n=======================================================")
    print("AgroRescue Standalone Server Running (Zero-Dependency Engine)")
    print(f"Access Web Application: http://{host}:{port}")
    print("=======================================================\n")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping server.")
        server.server_close()

